<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="imio.reportproblem"
>

  <body>

    <metal:main fill-slot="main">

      <!-- Everything the modal extracts from this page lives inside this
         element, whose id is "constants.FORM_CONTENT_ID": the title, the
         introduction and the form itself, so both display modes show them
         without the template being duplicated.

         Anything that must show on the standalone page but NOT in the modal
         goes after it, the back link below being the one case. That is what
         replaces any "am I inside a modal?" test on the Python side. -->
      <div class="report-problem-form"
           tal:attributes="
             id view/form_content_id;
           "
      >

        <h1 class="documentFirstHeading"
            tal:content="view/label"
        >Report a problem</h1>

        <div class="documentDescription lead"
             tal:condition="view/description"
             tal:content="view/description"
        >Spotted an error on this content?</div>

        <!-- Fail closed: no recipient configured, or an anonymous visitor and no
           captcha available. One single condition, see
           "report.is_report_available". -->
        <p class="portalMessage warning alert alert-warning"
           role="alert"
           tal:condition="not:view/available"
           tal:content="view/unavailable_message"
        >Reporting a problem is not available on this content.</p>

        <tal:form tal:condition="view/available">

          <!-- The macro emits plone.protect's "_authenticator" hidden input by
             itself, the view having "enableCSRFProtection" set. It lands inside
             the "form" element, hence inside the element the modal extracts, so
             the token travels with an AJAX submission just as it does with a
             plain one. Emitting a second one here would be pointless. -->
          <metal:form use-macro="context/@@ploneform-macros/titlelessform" />

          <!-- The hCaptcha script renders its widgets when the document loads.
             Injected into a modal it never fires by itself, and the captcha
             would stay empty, so the render is asked for explicitly here.

             This script is inside the extracted element on purpose: that is
             what makes it travel into the modal along with the widget. In page
             mode it is a no-op, the widget being already rendered by then,
             which is exactly what the guard below checks, so a widget is never
             rendered twice. -->
          <script type="text/javascript"
                  tal:condition="view/show_captcha"
          >
          (function () {
            var ATTEMPTS = 40;
            var INTERVAL = 250;
            var attempts = 0;

            function pending() {
              var widgets = document.querySelectorAll(".h-captcha");
              return Array.prototype.filter.call(widgets, function (element) {
                return (
                  !element.getAttribute("data-hcaptcha-widget-id") &&
                  !element.querySelector("iframe")
                );
              });
            }

            function render() {
              if (!window.hcaptcha || typeof window.hcaptcha.render !== "function") {
                return false;
              }
              pending().forEach(function (element) {
                try {
                  element.setAttribute(
                    "data-hcaptcha-widget-id",
                    window.hcaptcha.render(element)
                  );
                } catch (error) {
                  // Already rendered by the hCaptcha script itself.
                }
              });
              return true;
            }

            function poll() {
              attempts += 1;
              if (render() || attempts >= ATTEMPTS) {
                return;
              }
              window.setTimeout(poll, INTERVAL);
            }

            poll();
          })();
          </script>

        </tal:form>

      </div>

      <!-- OUTSIDE the extracted element on purpose: the modal does not pick it
         up, the standalone page shows it. -->
      <div class="report-problem-back">
        <a class="report-problem-back-link"
           tal:attributes="
             href view/context_url;
           "
        ><span i18n:translate="report_problem_back">Back to the content</span></a>
      </div>

    </metal:main>

  </body>

</html>
